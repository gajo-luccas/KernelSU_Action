KERNEL_SOURCE=https://github.com/tejas101k/kernel_xiaomi_vayu/
KERNEL_SOURCE_BRANCH=sixteen
KERNEL_CONFIG=vayu_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
SUBARCH=arm64

# COMPILADOR
COMPILER=clang
CLANG_VERSION=r450784d

# INJETAR KERNELSU-NEXT FORÇADO
ENABLE_KERNELSU=true
KERNELSU_REPOS=KernelSU-Next/KernelSU-Next

# ATIVAR SUSFS
ENABLE_SUSFS=true
SUSFS_VERSION=v4.14
