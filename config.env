KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=vayu-r-oss

ARCH=arm64
KERNEL_CONFIG=vayu_user_defconfig
KERNEL_IMAGE_NAME=Image.gz

CLANG_BRANCH=android11-qpr3-release
CLANG_VERSION=r377782c

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=false

KSU_VARIANT=none
ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
