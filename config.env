KERNEL_SOURCE=https://github.com
KERNEL_SOURCE_BRANCH=sixteen
KERNEL_CONFIG=vayu_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
SUBARCH=arm64

# COMPILADOR
COMPILER=clang
CLANG_VERSION=r450784d

# ATIVAR KERNELSU-NEXT (Padrão novo do script)
KSU_VARIANT=next

# ATIVAR SUSFS
ENABLE_SUSFS=true
SUSFS_VERSION=v4.14
