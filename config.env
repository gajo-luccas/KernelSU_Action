KERNEL_SOURCE=https://github.com/tejas101k/kernel_xiaomi_vayu/
KERNEL_SOURCE_BRANCH=sixteen
KERNEL_CONFIG=vayu_user_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
SUBARCH=arm64

# COMPILADOR
COMPILER=clang

# CORREÇÃO DEFINITIVA DE DIRETÓRIO PARA ESSA ACTION
EXTRA_CMDS=cd .. && mv android-kernel_xiaomi_vayu android-kernel || true
