KERNEL_SOURCE=https://github.com/tejas101k/kernel_xiaomi_vayu
KERNEL_SOURCE_BRANCH=sixteen

ARCH=arm64

KERNEL_CONFIG=vayu_user_defconfig

KERNEL_IMAGE_NAME=Image-dtb

CLANG_BRANCH=android11-qpr3-release
CLANG_VERSION=r377782c

USE_LLVM=true

ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

CUSTOM_CMDS=V=1

KSU_VARIANT=none

ENABLE_SUSFS=false

ENABLE_PATH_UMOUNT=false

ENABLE_HIDE_STUFF=false
