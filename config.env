KERNEL_SOURCE=https://github.com/gajo-luccas/kernel_xiaomi_vayu
KERNEL_SOURCE_BRANCH=helios-vayu-rebuild

ARCH=arm64

KERNEL_CONFIG=vayu_user_defconfig

KERNEL_IMAGE_NAME=Image-dtb

CLANG_BRANCH=android11-qpr3-release
CLANG_VERSION=r377782c

USE_LLVM=false

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=false

CUSTOM_CMDS=CC=clang

KSU_VARIANT=none

ENABLE_SUSFS=false

ENABLE_PATH_UMOUNT=false

ENABLE_HIDE_STUFF=false
