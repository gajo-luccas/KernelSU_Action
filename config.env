KERNEL_SOURCE=https://github.com/LuffyTaro008/android_kernel_xiaomi_vayu
KERNEL_SOURCE_BRANCH=staging-3

ARCH=arm64
KERNEL_CONFIG=vayu_defconfig
KERNEL_IMAGE_NAME=Image

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

KSU_VARIANT=none
ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
